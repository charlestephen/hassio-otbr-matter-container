TZ=America/New_York

# Host LAN interface used by OTBR backbone + Matter primary-interface
BACKBONE_IF=eth0

# Prefer a by-id path on the host, mapped to the same path in the container:
#   DEVICE_HOST=/dev/serial/by-id/usb-dresden_elektronik_Thread_RCP__ConBee_II__DE2221326-if00
#   DEVICE=/dev/serial/by-id/usb-dresden_elektronik_Thread_RCP__ConBee_II__DE2221326-if00
DEVICE_HOST=/dev/ttyACM0
DEVICE=/dev/ttyACM0

# ConBee II Thread RCP
BAUDRATE=115200
FLOW_CONTROL=1

# Data dirs (relative to compose.yml, or absolute)
HA_CONFIG=./ha_config
OTBR_DATA=./otbr_data
MATTER_DATA=./matter_data

# Matter Bluetooth adapter index (hci0 → 0)
MATTER_BT_ADAPTER=0
