TZ=America/New_York

# Host LAN interface used by the OTBR backbone and the Matter primary interface
# (list interfaces with: ip -br link)
BACKBONE_IF=eth0

# Thread radio on the host. Prefer a stable by-id path (ls /dev/serial/by-id/),
# for example /dev/serial/by-id/usb-<vendor>_<radio>-if00
DEVICE_HOST=/dev/ttyACM0
# Path the container uses for the radio. Leave as is.
DEVICE=/dev/ttyACM0

# ConBee II Thread RCP. Use your radio's values if it is different.
BAUDRATE=115200
FLOW_CONTROL=1

# Data directories (relative to compose.yml, or absolute)
HA_CONFIG=./data/hassio
OTBR_DATA=./data/thread
MATTER_DATA=./data/matter

# Matter Bluetooth adapter index (hci0 is 0)
MATTER_BT_ADAPTER=0
