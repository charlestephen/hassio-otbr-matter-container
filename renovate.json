{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "labels": [
    "dependencies"
  ],
  "commitMessagePrefix": "chore(deps):",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Containerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\nARG VERSION=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^upstream_version\\.txt$/"
      ],
      "matchStrings": [
        "^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "homeassistant/amd64-addon-otbr",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "HA OTBR app base image \u2014 bump Containerfile + upstream_version.txt together",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "homeassistant/amd64-addon-otbr",
        "docker.io/homeassistant/amd64-addon-otbr"
      ],
      "groupName": "homeassistant-addon-otbr",
      "commitMessageTopic": "Home Assistant OTBR base",
      "schedule": [
        "before 6am on monday"
      ]
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions",
      "schedule": [
        "before 6am on monday"
      ]
    }
  ]
}
